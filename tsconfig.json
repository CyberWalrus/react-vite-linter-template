{
    "extends": "@cyber-walrus/typescript-config/tsconfig.json",
    "compilerOptions": {
        "typeRoots": [
            "./node_modules/@types",
            "./types"
        ],
        "baseUrl": "./",
        "paths": {
            "$*": [
                "src/*"
            ]
        }
    },
    "include": [
        "src",
        "stylelint.config.cjs",
        "eslint-config",
        "types",
        "storybook",
        "scripts",
        "vitest.setup.ts",
        ".eslintrc.cjs",
        "*.config.js",
        "*.config.cjs",
        "typed-scss-modules.config.js",
        "*.config.mjs",
        "*.config.ts",
        "__mocks__"
    ],
    "exclude": [
        "node_modules",
        "public"
    ]
}